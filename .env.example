# =============================================================================
# BlastSpec — local development template
# Copy to .env and fill the secrets. Never commit .env.
#   cp .env.example .env
#   docker compose -f infra/docker-compose.yml exec backend php artisan key:generate
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=BlastSpec
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database ----------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=blastspec
DB_USERNAME=blastspec
DB_PASSWORD=blastspec

# --- Redis -------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=blastspec
STREAM_PREFIX=blastspec

# --- Graph service -----------------------------------------------------------
GRAPH_SERVICE_URL=http://graph-service:8001
GRAPH_SERVICE_TOKEN=dev-graph-token-change-me-32-chars
GRAPH_TIMEOUT_SECONDS=10
KUZU_PATH=/data/kuzu
GRAPH_MAX_NODES=100000
GRAPH_MAX_EDGES=500000
GRAPH_NODE_RETURN_LIMIT=50000

# --- Webhooks ----------------------------------------------------------------
WEBHOOK_SECRET=dev-webhook-secret-change-me-32-chars
WEBHOOK_PREVIOUS_SECRET=
WEBHOOK_TOLERANCE_SECONDS=300

# --- Auth and demo workspace -------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=false
DEMO_USER_EMAIL=demo@blastspec.dev
DEMO_USER_PASSWORD=demo-password
DEMO_WORKSPACE_NAME=Demo workspace

# --- CORS and rate limits ----------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_WEBHOOK_PER_MINUTE=60

# --- Outbox and streams ------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
STREAM_PENDING_TIMEOUT_SECONDS=60
STREAM_MAX_ATTEMPTS=3
STREAM_BACKOFF_SECONDS=2,10,30

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=BlastSpec

# --- Observability (optional) ------------------------------------------------
SENTRY_DSN=
METRICS_ENABLED=false

# =============================================================================
# Production notes
# - Generate APP_KEY with: php artisan key:generate --show
# - GRAPH_SERVICE_TOKEN and WEBHOOK_SECRET must be at least 32 random bytes.
# - SESSION_SECURE_COOKIE=true and APP_DEBUG=false.
# - CORS_ALLOWED_ORIGINS must be exact origins; never "*" with credentials.
# - Use distinct secrets per environment.
# =============================================================================
